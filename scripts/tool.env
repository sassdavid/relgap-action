# The only tool-specific settings. scripts/install.sh, scripts/run.sh and the tests source this file.
TOOL_NAME=relgap
TOOL_REPO=sassdavid/relgap
TOOL_SIGNER_WORKFLOW=sassdavid/relgap/.github/workflows/release.yml
# renovate: datasource=github-releases depName=sassdavid/relgap
TOOL_VERSION=0.12.1

# The commands each mode takes; the first is the default. The commands in TOOL_SARIF_COMMANDS
# also write SARIF and annotations.
TOOL_REPORT_COMMANDS="outdated drift"
TOOL_COMMENT_COMMANDS="digest"
TOOL_SARIF_COMMANDS="outdated drift"
# Flags that comment mode puts before the generated ones, per command: TOOL_COMMENT_FLAGS_<command>.
TOOL_COMMENT_FLAGS_digest="--pull-request"
# The flag that the from input sets, and a file in that directory that a second flag names when
# it exists. relgap has neither, so from must stay empty.
TOOL_FROM_FLAG=""
TOOL_FROM_FILE_FLAG=""
TOOL_FROM_FILE=""
